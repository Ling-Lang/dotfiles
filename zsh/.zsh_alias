alias sc="nvim $HOME/.zshrc && nvim $HOME/.zsh_alias && nvim $HOME/.zsh_export && source $HOME/.zshrc"
alias ls="eza"
alias lt="eza --tree"
alias d_init="bash /home/kulka/.env/init_docker.sh"
alias d_start="bash /home/kulka/.env/start.sh"
alias pv="source ./.venv/bin/activate"
alias python=python3

